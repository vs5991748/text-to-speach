# Copy this file to .env and fill in your values.

# Superusers: username:password pairs, comma-separated. No limits apply.
SU_USERS=admin:changeme

# Regular users: username:password pairs, comma-separated. All limits apply.
# Passwords may contain colons (:) but not commas (,).
USERS=

# Maximum number of sentence pairs processed per file (0 = disabled)
MAX_ROWS=200

# Maximum total rows a single user may process within the rate-limit window (0 = disabled)
MAX_ROWS_PER_WINDOW=1000

# Maximum characters allowed per sentence string (0 = disabled)
MAX_STRING_LENGTH=500

# Rate limiting: max generation requests per user within the time window (0 = disabled)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Maximum seconds a generation job may run before it is aborted (0 = disabled)
GENERATION_TIMEOUT_SECONDS=600

# Copy this file to .env and fill in your values.

# Superusers: username:password pairs, comma-separated. No limits apply.
SU_USERS=admin:changeme

# Regular users: username:password pairs, comma-separated. All limits apply.
# Passwords may contain colons (:) but not commas (,).
USERS=

# Maximum number of sentence pairs processed per file (0 = disabled)
MAX_ROWS=200

# Maximum total rows a single user may process within the rate-limit window (0 = disabled)
MAX_ROWS_PER_WINDOW=1000

# Maximum characters allowed per sentence string (0 = disabled)
MAX_STRING_LENGTH=500

# Rate limiting: max generation requests per user within the time window (0 = disabled)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Maximum seconds a generation job may run before it is aborted (0 = disabled)
GENERATION_TIMEOUT_SECONDS=600

# Minimum seconds a user must wait between generation requests (0 = disabled)
GENERATION_COOLDOWN_SECONDS=60

# Minimum seconds a user must wait between AI phrase suggestions (0 = disabled)
LLM_SUGGEST_COOLDOWN_SECONDS=60

# ── AI phrase generation ──────────────────────────────────────────────────────
# Default LLM provider for regular users (openrouter | groq | ollama | blank = disabled)
LLM_DEFAULT=openrouter

# LLM provider for superusers — overrides LLM_DEFAULT for SU_USERS (leave blank to use LLM_DEFAULT)
LLM_SU_DEFAULT=

# Per-user override (optional edge-case escape hatch)
# LLM_USER_SPECIFICUSER=groq

# Max tokens for LLM responses (increase for reasoning models, e.g. 1500)
LLM_MAX_TOKENS=600

# Request timeout in seconds and max retries with exponential backoff
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# OpenRouter (https://openrouter.ai — free models available)
LLM_OPENROUTER_MODEL=google/gemma-2-9b-it:free
LLM_OPENROUTER_API_KEY=

# Groq (https://console.groq.com — free tier ~14k req/day)
LLM_GROQ_MODEL=llama-3.1-8b-instant
LLM_GROQ_API_KEY=

# Ollama (local — no API key needed)
LLM_OLLAMA_MODEL=llama3.2
# LLM_OLLAMA_BASE_URL=http://localhost:11434

# ── Google Drive upload (optional) ────────────────────────────────────────────
# Blank client ID/secret/redirect URI disables the feature entirely.
# See doc/google-cloud-setup.md for the Google Cloud Console setup walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Top-level Drive folder name every user's uploads go into (created on first upload)
GOOGLE_DRIVE_FOLDER_NAME=TTS Audio
